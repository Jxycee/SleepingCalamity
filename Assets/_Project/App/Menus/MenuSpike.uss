.spike-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.spike-button {
    width: 320px;
    height: 72px;
    font-size: 28px;
}

.spike-button:focus {
    border-color: rgb(255, 214, 120);
    border-width: 3px;
}
